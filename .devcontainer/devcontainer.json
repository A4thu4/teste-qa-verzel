{
  "name": "teste-qa-verzel",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Roda uma vez, quando o Codespace é criado: instala as dependências
  // da automação e o Chromium com as bibliotecas de sistema que ele precisa.
  // A imagem base traz o repositório apt do Yarn com a chave de assinatura
  // vencida, o que faz o apt-get update falhar e aborta a instalação do
  // navegador. O Yarn não é usado aqui, então esse repositório é removido antes.
  "postCreateCommand": "sudo grep -rl yarnpkg /etc/apt/sources.list.d | xargs -r sudo rm -f; pip install -r automacao/requirements.txt && python -m playwright install --with-deps chromium",

  // Fuso de Brasília no terminal do Codespace, para que horários de saída
  // (pytest, git, scripts) batam com o horário local.
  "containerEnv": {
    "TZ": "America/Sao_Paulo"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "alexkrechik.cucumberautocomplete"
      ],
      "settings": {
        // Faz os testes aparecerem na aba "Testing" do VS Code.
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${workspaceFolder}/automacao",
        "python.testing.pytestArgs": ["tests"],
        "cucumberautocomplete.steps": [],
        "cucumberautocomplete.strictGherkinCompletion": false
      }
    }
  }
}
